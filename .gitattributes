# Lo que no sale al publicar: `git archive` respeta `export-ignore`.

# La lista de patrones se queda en GitLab: deletrea nombres internos y el
# revisor no puede revisarse a si mismo (se excluye para no cazarse siempre).
.publicable-prohibido.txt export-ignore

# GitHub mide el lenguaje del repositorio con Linguist, y los guiones que verifican
# el curso pesan mas que el material: por eso un curso de Go aparecia como de Shell.
# Estos no son el lenguaje que se ensena, asi que no cuentan para esa medida.
herramientas/*.sh linguist-detectable=false
verificar-publicable.sh linguist-detectable=false
